# POC Next Backend Configuration
# Copy this file to .env and update values as needed

# --- Application ---
APP_HOST=0.0.0.0
APP_PORT=5001
LOG_LEVEL=INFO

# --- MASS Connector (Provider) ---
MASS_MANAGEMENT_URL=https://edc-mass-control.51.178.94.25.nip.io/management
MASS_API_KEY=mass-api-key-change-in-production
MASS_BPN=BPNL00000000MASS
MASS_DSP=https://edc-mass-control.51.178.94.25.nip.io/api/v1/dsp

# --- IKLN Connector (Consumer) ---
IKLN_MANAGEMENT_URL=https://edc-ikln-control.51.178.94.25.nip.io/management
IKLN_API_KEY=ikln-api-key-change-in-production
IKLN_BPN=BPNL00000002IKLN
IKLN_DSP=https://edc-ikln-control.51.178.94.25.nip.io/api/v1/dsp

# --- Kubernetes ---
# KUBECONFIG_PATH=/path/to/kubeconfig.yaml

# --- Sample Data ---
PDF_URL=https://www.w3.org/WAI/ER/tests/xhtml/testfiles/resources/pdf/dummy.pdf

# --- SharePoint Configuration ---
SHAREPOINT_DRIVE_ID=db572124-e392-4921-b1f7-7c2d73b328c2
# The drive ID can be obtained from Microsoft Graph API
# Example: b!Xyz123...abc

# --- SharePoint Proxy Configuration (for EDC Downloads) ---
# NOTA: Puedes reutilizar el mismo Client ID del frontend (más simple)
# Solo necesitas añadir un Client Secret en Azure AD (misma app)
# Y configurar permisos Application: Files.Read.All, Sites.Read.All
SHAREPOINT_PROXY_CLIENT_ID=a1fc2076-f046-4a0f-90e7-4601aeb5b856
SHAREPOINT_PROXY_CLIENT_SECRET=generate-client-secret-in-azure-ad
SHAREPOINT_PROXY_TENANT_ID=910ac815-f855-4a08-bf29-90b46552cf11

# Base URL of the proxy (must be accessible from EDC DataPlane)
# Development: http://localhost:5001
# Production: https://sharepoint-proxy.your-domain.com
SHAREPOINT_PROXY_BASE_URL=http://localhost:5001
