apiVersion: v1
kind: Secret
metadata:
  name: sharepoint-proxy-credentials
  namespace: ds-management-ui
type: Opaque
stringData:
  # Azure AD Service Principal credentials for SharePoint access
  # Replace these placeholder values with your actual credentials
  client-id: "${SHAREPOINT_CLIENT_ID}"
  client-secret: "${SHAREPOINT_CLIENT_SECRET}"
  tenant-id: "${SHAREPOINT_TENANT_ID}"
